import java.util.*;

class BeingZero
{
    int sizeOfTree(BTNode root)
    {
        if(root==null) return 0;
      return 1 + sizeOfTree(root.left) + sizeOfTree(root.right);
    }
}

class BTNode
{
    int data;
    BTNode left, right;
    BTNode(int d)
    {
      	data = d;
      	left = right = null;
    }
}

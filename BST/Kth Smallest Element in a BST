//leetcode 230
/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int kthSmallest(TreeNode root, int k) {
        ArrayList<Integer> a = new ArrayList<>();
        inorder(root, a);
        int ans = a.get(k-1);
        return ans;
    }
    void inorder(TreeNode n, ArrayList<Integer> a)
    {
        if(n==null) return;
        inorder(n.left, a);
        a.add(n.val);
        inorder(n.right, a);
    }
}

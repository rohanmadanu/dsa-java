//Leetcode 1161
/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int maxLevelSum(TreeNode root) {
        if(root==null) return 0;
        Queue<TreeNode> q = new LinkedList<>();
        int maxsum = -1000000;
        q.add(root);
        int currlevel = 0;
        int maxlevel = 0;
        while(!q.isEmpty())
        {
            int size = q.size();
            int levelsum = 0;
            currlevel++;
            for(int i=0; i<size; i++)
            {
                TreeNode f = q.remove();
                levelsum = f.val + levelsum;
                if(f.left!=null) q.add(f.left);
                if(f.right!=null) q.add(f.right);
            }
            if(levelsum>maxsum)
            {
                maxsum = levelsum;
                maxlevel = currlevel;
            }
        }
        return maxlevel;
    }
}
